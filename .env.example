VITE_ASSISTANT_API_URL=http://localhost:8787
VITE_PWA=true

PORT=8787
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://localhost,capacitor://localhost,ionic://localhost
ASSISTANT_RATE_LIMIT_PER_MINUTE=20
# Keep true for no-cost local demos; set false to enable Agicto chat and semantic mission review.
AI_MOCK=true

# Agicto OpenAI-compatible API. Keep this key server-side only.
AGICTO_API_KEY=
AGICTO_BASE_URL=https://api.agicto.cn/v1/
AGICTO_CHAT_MODEL=qwen-turbo
