FROM node:22.12.0 AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM node:22.12.0 AS production
WORKDIR /app
COPY --from=builder /app/dist/ /app/dist/
COPY package.json .
COPY vite.config.ts .
RUN npm install typescript
EXPOSE 8080
CMD [ "npm", "run", "preview" ]
